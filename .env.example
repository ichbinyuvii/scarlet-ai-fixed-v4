# Local preview. Copy to .env and run npm run migrate before the first launch.
PUBLIC_DEPLOYMENT=0
# Empty origin accepts the local loopback host and port. Public mode requires the exact HTTPS origin.
APP_ORIGIN=
SCARLET_DATA_DIR=.scarlet
# Empty selects embedded PostgreSQL with pgvector. Set both URLs for distributed workers.
DATABASE_URL=
REDIS_URL=
# Required in public mode. Generate once with: openssl rand -base64 32
SCARLET_MASTER_KEY=
# Local-only Ollama discovery. Zero disables it. No remote provider is connected by default.
LOCAL_MODEL_DISCOVERY=1
AI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_ID=
DAILY_MODEL_CALLS=40
# Optional verified OpenAI embedding model that accepts 1536-dimensional output.
EMBEDDING_MODEL=
# Optional JSON object keyed by provider and tier (fast, conversation, coding, reasoning, vision).
MODEL_ROUTES_JSON=
# Approved read-only HTTPS sources and browser executable; blank executable uses Playwright's installed browser.
RESEARCH_HOSTS=example.org
CHROMIUM_PATH=
CLAMAV_SOCKET=
# Public transactional account email through a verified Resend sending domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# OAuth callback must exactly match the Google Cloud authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Meta operator configuration. Users enter their own authorized token and eligible phone ID in Integrations.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
# Enable only when one trusted proxy controls the forwarded client header.
TRUST_PROXY=0

# Optional server-owned plan limits. Keys may override dailyModelCalls, dailyWorkflows, storageBytes.
PLAN_LIMITS_JSON=

# Optional image generation. See docs/IMAGES.md. Cloud generation incurs provider charges.
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
# Optional. Defaults to gpt-image-1 when OPENAI_API_KEY is set.
OPENAI_IMAGE_MODEL=
# For IMAGE_PROVIDER=local, supply an existing OpenAI-compatible image server and installed image model.
# Loopback only: 127.0.0.1, localhost or [::1], path /v1.
LOCAL_IMAGE_BASE_URL=
LOCAL_IMAGE_MODEL=
LOCAL_IMAGE_API_KEY=
DAILY_IMAGE_GENERATIONS=3
DAILY_IMAGE_SITE_LIMIT=30
# LinkedIn developer application credentials and exact callback URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=202601
